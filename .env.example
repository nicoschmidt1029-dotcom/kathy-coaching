# Katie Coaching — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# In production (Vercel), set these in Project Settings → Environment Variables.

# --- Email (Resend) ---
# Sign up at https://resend.com, create an API key, paste it here.
# Free tier: 3,000 emails/month, 100/day.
RESEND_API_KEY=re_replace_me

# Address that receives the contact-form emails (Katie's inbox).
CONTACT_TO_EMAIL=hello@example.com

# "From" address shown in the email. Until Katie verifies her own domain
# in Resend, keep it as onboarding@resend.dev (Resend's shared sender).
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Site URL ---
# Canonical origin for absolute URLs (OpenGraph/metadata, robots, sitemap).
# In production, set this in Vercel → Settings → Environment Variables to the
# live domain. If unset, the app falls back to Vercel's production URL, then
# localhost for dev (see lib/site-url.ts). Example:
# NEXT_PUBLIC_SITE_URL=https://katie-coaching.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
ADMIN_EMAILS=katey.coaching.newlife@gmail.com
