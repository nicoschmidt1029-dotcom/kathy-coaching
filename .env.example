# Kathy Coaching — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# In production (Vercel), set these in Project Settings → Environment Variables.

# --- Email (Resend) ---
# Sign up at https://resend.com, create an API key, paste it here.
# Free tier: 3,000 emails/month, 100/day.
RESEND_API_KEY=re_replace_me

# Address that receives the contact-form emails (Kathy's inbox).
CONTACT_TO_EMAIL=hello@example.com

# "From" address shown in the email. Until Kathy verifies her own domain
# in Resend, keep it as onboarding@resend.dev (Resend's shared sender).
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Site URL ---
# Used for absolute URLs in OpenGraph/metadata. Overrides the fallback in
# app/layout.tsx. Set it once the final production domain is live.
NEXT_PUBLIC_SITE_URL=https://kathy-coaching.vercel.app
